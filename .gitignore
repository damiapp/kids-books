# Generated by `flutter create` in CI (and locally) — never committed.
.dart_tool/
.packages
build/
android/
ios/
linux/
macos/
windows/
web/
pubspec.lock

# Signing material. The release key lives in the ANDROID_KEYSTORE_BASE64
# repo secret (README §1d) and must never land in the repo — this one is
# public, so a committed keystore is a leaked keystore.
*.jks
*.keystore
key.properties
*.base64.txt
